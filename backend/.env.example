# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
PORT=8080
HOST=0.0.0.0

# Set to 1 when running behind Render/Fly/Cloud Run so rate limits see real client IPs.
TRUST_PROXY=0

# Round state is held in memory only and expires after this many minutes.
ROUND_TTL_MINUTES=45

# Comma-separated origins allowed to call the API from a separate client.
# Only needed when running the Flutter web app on its own dev server, e.g.
# CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
CORS_ORIGINS=
